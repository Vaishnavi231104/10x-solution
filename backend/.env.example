# Copy this file to .env and fill it in. .env is gitignored: never commit real keys.

# Required: signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Required for AI features: free key from https://console.groq.com/keys
# Without it the app still works; AI steps fall back to simple defaults and the weekly
# insight becomes an automatic summary of your numbers.
GROQ_API_KEY=

# Groq retires models over time. List what your key can use:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b

# Database. Default is a local SQLite file. A postgres:// URL also works.
DATABASE_URL=sqlite:///./app.db

# Weekly report cron (5-field crontab, UTC). Default: Sundays 18:00. Set DISABLE_SCHEDULER=1 to turn it off.
WEEKLY_REPORT_CRON=0 18 * * sun
# DISABLE_SCHEDULER=1

# Optional: estimate spend on a paid plan (USD per 1M tokens). Leave unset on the free tier (cost = 0).
# LLM_PRICE_IN_PER_1M=0.10
# LLM_PRICE_OUT_PER_1M=0.40

# Optional: how long a cached weekly insight is reused (seconds, default 21600 = 6 h).
# WEEKLY_CACHE_TTL_SECONDS=21600

# Optional: comma-separated allowed browser origins (default *). Set ENVIRONMENT=production to REQUIRE SECRET_KEY.
# CORS_ORIGINS=https://your-frontend.example.com
# ENVIRONMENT=production
